.docdescription {Documentation for gol-bevy, Conway's Game of Life with a native desktop GUI built on Bevy.}
.doclang {English}
.theme {darko} layout:{minimal}

.dockeywords
  - game of life
  - cellular automaton
  - bevy
  - rust

.docauthors
  - Andreas Hernández Hauser

.ifnot {.docname::equals {gol-bevy}}
    .htmloptions title:{.docname | gol-bevy}

.var {repourl} {https://github.com/andreashdez/gol_bevy}

.function {repolink}
    label path:
    .text {.label} url:{.repourl/.path}

.pagemargin {topleft}
    [gol-bevy](@)

.pagemargin {topright}
    .text {.icon {github} GitHub} url:{.repourl}
